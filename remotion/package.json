{
  "name": "levela-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project for Levela promo videos (dynamic telop + hype BGM)",
  "scripts": {
    "studio": "npm run bgm && remotion studio",
    "bgm": "node scripts/make-bgm.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "source": "node scripts/prepare-source.mjs",
    "render": "npm run bgm && remotion render HypeTelop out/hype-telop.mp4 --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.501",
    "@remotion/google-fonts": "4.0.501",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.501"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
